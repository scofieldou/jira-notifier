{
  "manifest_version": 3,
  "name": "Jira Notifier",
  "version": "1.3.1",
  "description": "被 assign 到 Jira 單時跳桌面通知，並列出目前待處理的單（依專案分組、優先度排序）",
  "permissions": ["alarms", "notifications", "storage"],
  "host_permissions": ["https://raw.githubusercontent.com/scofieldou/jira-notifier/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jira Notifier",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
